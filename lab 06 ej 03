using namespace std;

int main() {
long long N, aux;

// 1. Leer un número entero positivo N
do {
cout << "Ingrese un numero entero positivo N: ";
cin >> N;
if (N <= 0) {
cout << "El numero debe ser un entero positivo (mayor a 0). Intente nuevamente.\n";
}
} while (N <= 0);

// Guardamos una copia en 'aux' para procesar los dígitos sin perder el valor original de N
aux = N;

int cantidadTotalDigitos = 0;
int cantidadMayoresA5 = 0;
int sumaMayoresA5 = 0;

// Estructura iterativa para procesar dígito por dígito de derecha a izquierda
while (aux > 0) {
// 2. Extraer cada dígito utilizando el operador módulo (%)
int digito = aux % 10;

// 3. Contar todos los dígitos procesados
cantidadTotalDigitos++;

// 4. Determinar si cada dígito es mayor a 5
if (digito > 5) {
// 5. Contar y sumar únicamente los dígitos mayores a 5
cantidadMayoresA5++;
sumaMayoresA5 += digito;
}

// 6. Eliminar el dígito procesado mediante división entera entre 10
aux /= 10;
}

// 7. Mostrar los tres resultados solicitados
cout << "\n----------------------------------------\n";
cout << "RESULTADOS DEL ANALISIS DE DIGITOS\n";
cout << "----------------------------------------\n";
cout << "Cantidad total de digitos: " << cantidadTotalDigitos << endl;
cout << "Cantidad de digitos mayores a 5: " << cantidadMayoresA5 << endl;
cout << "Suma de los digitos mayores a 5: " << sumaMayoresA5 << endl;

return 0;
}
