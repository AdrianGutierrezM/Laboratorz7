#include <iostream>
#include <string>
using namespace std;

int BuscarSubCadena(string a, string b) {
int tamA = a.length();
int tamB = b.length();

if (tamA > tamB) {
return -1;
}

for (int i = 0; i <= tamB - tamA; i++) {
if (b.substr(i, tamA) == a) {
return i; 
}
}

return -1; 
}

int main() {
string a = "holaxd";
string b = "hooola";

int resultado = BuscarSubCadena(a, b);
cout << "Salida: " << resultado << endl;

return 0;
}
