#include <iostream>
#include <string>

using namespace std;

int main() {
    // 1. Declarar variables
    string nombre;
    int edad;
    string carrera;
    int semestre;

    // 2. Pedir los datos
    cout << "Ingrese nombre: ";
    cin >> nombre;

    cout << "Ingrese edad: ";
    cin >> edad;

    cout << "Ingrese carrera: ";
    cin >> carrera;

    cout << "Ingrese semestre: ";
    cin >> semestre;

    // 3. Mostrar los datos registrados
    cout << "\n--- DATOS REGISTRADOS ---" << endl;
    cout << "Nombre: " << nombre << endl;
    cout << "Edad: " << edad << endl;
    cout << "Carrera: " << carrera << endl;
    cout << "Semestre: " << semestre << endl;

    // 4. Evaluar la condicion con el if
    if (edad >= 18) {
        cout << "El estudiante es mayor de edad" << endl;
    } else {
        cout << "El estudiante es menor de edad" << endl;
    }

    return 0;
}
